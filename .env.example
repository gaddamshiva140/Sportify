# Sportify Supabase Integration Environment Variables
# Copy this file to '.env' in the same folder and fill in your Supabase project API keys.

# 1. Supabase API Project URL (found under Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Supabase Anon Public Key (found under Project Settings -> API)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
